# Copia este archivo como .env y completa con tus valores reales de Supabase
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key

# Wompi — llave PÚBLICA únicamente (la de integridad y la de eventos son
# secretos de servidor, se configuran con `supabase secrets set`, nunca aquí)
VITE_WOMPI_PUBLIC_KEY=pub_test_xxxxxxxxxxxxxxxxxxxxxxxx